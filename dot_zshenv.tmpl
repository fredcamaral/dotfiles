{{ if eq .chezmoi.os "darwin" -}}
# Keep Homebrew binaries visible to non-interactive SSH commands.
# Mosh starts mosh-server through SSH, which does not read .zprofile.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Keep remote shells usable from Termius/Mosh: UTF-8 text and ANSI colors.
export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export CLICOLOR=1

case "${TERM:-}" in
  ""|dumb|vt100|xterm)
    export TERM=xterm-256color
    ;;
esac
{{- else if eq .chezmoi.os "linux" -}}
# ================================================================
# .zshenv — lido por TODA invocacao do zsh (inclusive ssh nao-interativo)
# Portado do rivendell (Mac/homebrew) -> Debian.
# ================================================================

# PATH (dedupe via typeset -U). Aqui no .zshenv pra que `ssh workstation 'go version'` funcione.
typeset -U path PATH
export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/go/bin:$PATH"

# Editor padrao (voce usa micro no rivendell)
export EDITOR="micro"
export VISUAL="micro"

# UTF-8 + cores pra shells remotos (Termius/Mosh/SSH) — espelha o rivendell
export LANG="${LANG:-en_US.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
export CLICOLOR=1

# ---- XDG base dirs — explicitos p/ previsibilidade (sao os defaults, mas garante) ----
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# ---- XDG_RUNTIME_DIR / DBUS — fallback p/ ssh nao-login, panes, cron (Linux-only) ----
# Sem isso: `systemctl --user`/dbus dao "Failed to connect to bus: $XDG_RUNTIME_DIR not defined".
# Os guards (-d / -S) tornam isto no-op no rivendell (Mac), entao e seguro espelhar.
if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

case "${TERM:-}" in
  ""|dumb|vt100|xterm)
    export TERM=xterm-256color
    ;;
esac
{{- end }}
