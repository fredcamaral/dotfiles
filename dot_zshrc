# ================================================================
# .zshrc — modular loader
# ================================================================

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="simple-fred"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Load modules
for f in "$HOME/.config/zsh"/*.zsh; do
  [[ -f "$f" ]] && source "$f"
done

# ai-sessions (must be last — provides ai-claude, ai-opencode, etc.)
[[ -f "$HOME/.config/ai-sessions/ai-sessions.sh" ]] && source "$HOME/.config/ai-sessions/ai-sessions.sh"


# Hermes Agent — ensure ~/.local/bin is on PATH
export PATH="$HOME/.local/bin:$PATH"

# pnpm
export PNPM_HOME="/Users/fredamaral/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
