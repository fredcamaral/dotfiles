#!/usr/bin/env zsh
# ail: agent layout engine for the isengard tmux session.
#
# Agent panes carry the @ai_agent pane option (cc/oc/cx/dr/pi) and a
# `prefix:repo/branch` pane title. ail re-packs them into "decks" — windows of
# N side-by-side columns — via break-pane/join-pane, which move LIVE panes
# without restarting the process underneath. Non-agent panes/windows (plain
# shells, manual splits) are never touched.
#
#   ail           one-line status: "mode 8 · 9 agents · 2 decks"
#   ail N         re-pack into decks of N (N in 1..9); N==1 = one named tab per agent
#   ail --repack  re-run the declared @ai_mode (pane-exited hook target);
#                 silent no-op when no session or no mode is declared
#   ail --desk    birth a new empty desk of N placeholders (N = declared
#                 mode); converts the current window when it is a lone idle
#                 shell, else creates a fresh window
#
# Fixed grid (Phase F): after packing, the LAST deck is padded to N with
# placeholder panes — plain shells tagged with the @ai_placeholder pane option,
# title `·`, @ai_agent unset (so ais/pickers ignore them). Mode 1 gets no
# padding by construction; zero agents + N>1 yields one desk of N placeholders.
# Idle placeholders (foreground command is the shell) are killable; a busy one
# is promoted to its own plain window instead — never killed.
#
# Extra desks: a window made ENTIRELY of placeholders is a desk in its own
# right (born from `ail --desk`) — preserved across packs, kept at exactly N
# panes, named after the agent decks (d2, d3…). Packing stays dense-left: an
# agent born in an extra-desk slot is pulled into earlier free slots first,
# so extra desks matter when the main deck is full. Mode 1 clears them all.
#
# Self-contained on purpose: tmux run-shell binds call it by absolute path and
# the tmux server's inherited PATH may lack ~/.local/bin — no zshrc, no
# ai-sessions.sh dependency. AIL_SOCKET (optional) routes every tmux call to
# `tmux -L $AIL_SOCKET` — the test-isolation seam used by ail-smoke; unset =
# default server.

typeset -g AIL_SESSION="isengard"

# Pane border: title colored per agent prefix (dracula) — cc orange · oc green
# · cx cyan · dr pink · pi yellow. tmux has no case, only nested #{?} chains.
typeset -g AIL_BORDER_FMT='#{?#{==:#{@ai_agent},cc},#[fg=#ffb86c],#{?#{==:#{@ai_agent},oc},#[fg=#50fa7b],#{?#{==:#{@ai_agent},cx},#[fg=#8be9fd],#{?#{==:#{@ai_agent},dr},#[fg=#ff79c6],#{?#{==:#{@ai_agent},pi},#[fg=#f1fa8c],}}}}} #{pane_title} #[default]'

# Every tmux call routes through here (${=...} forces word-splitting: zsh does
# not split unquoted expansions, and "-L ailsmoke" must be two argv words).
_ail_tmux() { command tmux ${=AIL_SOCKET:+-L $AIL_SOCKET} "$@" }

# Packable agent = @ai_agent set AND not @ai_manual. Agents opened inside a
# user-built split carry @ai_manual (set by the launcher) — they live where
# the user put them; ail must never pack, unzoom, or count them.
typeset -g AIL_PACK_FILTER='#{?#{@ai_manual},0,#{@ai_agent}}'

# _ail_agent_panes — "pane_id|pane_title" per packable agent pane, sorted by
# numeric pane id (ids are monotonic since server start = spawn order).
_ail_agent_panes() {
  _ail_tmux list-panes -s -t "=$AIL_SESSION" -f "$AIL_PACK_FILTER" \
    -F '#{pane_id}|#{pane_title}' 2>/dev/null | sort -t'|' -k1.2,1n
}

# _ail_deck_count — distinct isengard windows currently holding packable agents.
_ail_deck_count() {
  _ail_tmux list-panes -s -t "=$AIL_SESSION" -f "$AIL_PACK_FILTER" \
    -F '#{window_id}' 2>/dev/null | sort -u | wc -l | tr -d ' '
}

# _ail_deck_borders <window> — deck modes read agent identity off the pane
# border (the tab only says dN). Applied per deck window with -w: tmux ≥3.0
# has no session-scope storage for window options (set-option -t session
# resolves to the session's CURRENT window only), and per-window beats it
# anyway — non-agent windows in isengard keep their border settings too.
_ail_deck_borders() {
  _ail_tmux set-option -w -t "$1" pane-border-status top 2>/dev/null
  _ail_tmux set-option -w -t "$1" pane-border-format "$AIL_BORDER_FMT" 2>/dev/null
}

# _ail_fill_desk <window> <pad> <shell_base> — hold <window> at exactly <pad>
# placeholders: keep busy ones first (never sacrifice user state for an idle
# shell), promote busy extras to their own plain window, kill idle extras,
# spawn the shortfall off the window's LAST pane (placeholders trail right),
# re-layout. SPAWN before KILL: kills fire pane-exited → concurrent repacks
# must observe an already-padded desk so they never double-fill.
_ail_fill_desk() {
  local win="$1" sbase="$3"
  local -i pad="$2" kept=0 need=0 k
  local ph pid pcmd wpanes tail_pane w
  local -a keep_busy keep_idle kills promotes
  while IFS= read -r ph; do
    [[ -z "$ph" ]] && continue
    pid="${ph%%|*}"; pcmd="${ph#*|}"
    if [[ "$pcmd" == "$sbase" ]]; then keep_idle+=("$pid"); else keep_busy+=("$pid"); fi
  done < <(_ail_tmux list-panes -t "$win" -f '#{@ai_placeholder}' -F '#{pane_id}|#{pane_current_command}' 2>/dev/null)
  for pid in "${keep_busy[@]}"; do
    if (( kept < pad )); then (( ++kept )); else promotes+=("$pid"); fi
  done
  for pid in "${keep_idle[@]}"; do
    if (( kept < pad )); then (( ++kept )); else kills+=("$pid"); fi
  done
  need=$(( pad - kept ))
  for (( k = 0; k < need; k++ )); do
    tail_pane=$(_ail_tmux list-panes -t "$win" -F '#{pane_id}' 2>/dev/null | tail -n1)
    [[ -z "$tail_pane" ]] && tail_pane="$win"
    pid=$(_ail_tmux split-window -d -h -t "$tail_pane" -c "$HOME" -PF '#{pane_id}' 2>/dev/null) || continue
    [[ -z "$pid" ]] && continue
    _ail_tmux set-option -p -t "$pid" @ai_placeholder 1 2>/dev/null
    _ail_tmux select-pane -t "$pid" -T '·' 2>/dev/null
    # Re-layout after every split: split-window halves one pane — repeated
    # splits starve width long before even-horizontal would.
    _ail_tmux select-layout -t "$win" even-horizontal 2>/dev/null
  done
  for pid in "${promotes[@]}"; do
    _ail_tmux set-option -p -u -t "$pid" @ai_placeholder 2>/dev/null
    wpanes=$(_ail_tmux display-message -p -t "$pid" '#{window_panes}' 2>/dev/null)
    (( ${wpanes:-1} > 1 )) && _ail_tmux break-pane -d -s "$pid" -t "=$AIL_SESSION:" 2>/dev/null
    w=$(_ail_tmux display-message -p -t "$pid" '#{window_id}' 2>/dev/null)
    [[ -n "$w" ]] && _ail_tmux set-option -w -t "$w" automatic-rename on 2>/dev/null
  done
  for pid in "${kills[@]}"; do
    _ail_tmux kill-pane -t "$pid" 2>/dev/null
  done
  _ail_tmux select-layout -t "$win" even-horizontal 2>/dev/null
}

_ail_main() {
  local n="${1:-}"
  local -i quiet=0

  if ! command -v tmux >/dev/null 2>&1; then
    echo "ail: tmux not installed" >&2
    return 1
  fi

  # --repack: the pane-exited hook target. The hook is global — it fires for
  # panes of ANY session on servers that loaded the conf, so every "not ours"
  # branch is a SILENT rc-0 exit (a non-zero rc would paint a run-shell
  # overlay on every pane death).
  if [[ "$n" == "--repack" ]]; then
    _ail_tmux has-session -t "=$AIL_SESSION" 2>/dev/null || return 0
    n=$(_ail_tmux show-options -v -t "=$AIL_SESSION:" @ai_mode 2>/dev/null)
    [[ "$n" == <-> ]] && (( n >= 1 && n <= 9 )) || return 0
    quiet=1
  fi

  if ! _ail_tmux has-session -t "=$AIL_SESSION" 2>/dev/null; then
    echo "ail: no '$AIL_SESSION' session — spawn an agent first" >&2
    return 1
  fi

  # ---- no args: one-line status ----
  if [[ -z "$n" ]]; then
    local mode agents
    # NB: set-option/show-options take a target-PANE — exact-match needs
    # "=name:" (trailing colon); bare "=name" fails with "no such session".
    mode=$(_ail_tmux show-options -v -t "=$AIL_SESSION:" @ai_mode 2>/dev/null)
    agents=$(_ail_agent_panes | wc -l | tr -d ' ')
    print -r -- "mode ${mode:--} · $agents agents · $(_ail_deck_count) decks"
    return 0
  fi

  # --desk: birth a new empty desk (N = the declared mode). The seed pane is
  # tagged after the lock below; the reconciliation recognizes the resulting
  # pure-placeholder window as a desk and pads it to N.
  local -i want_desk=0
  if [[ "$n" == "--desk" ]]; then
    want_desk=1
    n=$(_ail_tmux show-options -v -t "=$AIL_SESSION:" @ai_mode 2>/dev/null)
    if [[ "$n" != <-> ]] || (( n < 2 || n > 9 )); then
      echo "ail: --desk needs a declared mode > 1 (run ail N first)" >&2
      return 1
    fi
  fi

  if [[ "$n" != <-> ]] || (( n < 1 || n > 9 )); then
    echo "usage: ail [N|--repack|--desk]   (N in 1..9)" >&2
    return 1
  fi

  # Serialize mutating runs: two near-simultaneous pane deaths fire two
  # --repacks; unserialized, both read the pane list before either pads and
  # can double-fill or scramble the tail deck. The lock is per-socket (smoke
  # servers must not serialize against the live one) and held until process
  # exit (fd closes). 10s timeout: if a holder ever wedges, proceeding
  # unlocked (the old behavior) beats never repacking again.
  zmodload zsh/system 2>/dev/null
  local lockfile="/tmp/ail-${UID}-${AIL_SOCKET:-default}.lock"
  local -i lockfd=-1
  : >>"$lockfile" 2>/dev/null
  zsystem flock -f lockfd -t 10 "$lockfile" 2>/dev/null

  # --repack resolved its mode BEFORE the lock: re-read it now, or a repack
  # that waited out a concurrent manual `ail N` would repack (and re-declare)
  # the stale mode, silently reverting the user's switch.
  if (( quiet )); then
    n=$(_ail_tmux show-options -v -t "=$AIL_SESSION:" @ai_mode 2>/dev/null)
    [[ "$n" == <-> ]] && (( n >= 1 && n <= 9 )) || return 0
  fi

  # Mode is declared intent, recorded even with zero agents: the spawn-side
  # auto-pack (_ai_run) reads @ai_mode before the first agent exists.
  _ail_tmux set-option -t "=$AIL_SESSION:" @ai_mode "$n"

  # Idle test base: a pane whose foreground command is still the shell.
  local shell_base
  shell_base=$(_ail_tmux show-options -gv default-shell 2>/dev/null)
  shell_base="${shell_base:t}"
  [[ -z "$shell_base" ]] && shell_base=zsh

  # --desk seed: convert the active window when it is a lone idle plain
  # shell (the "new tab, give me a desk here" gesture); otherwise create a
  # fresh window. One tagged placeholder is enough — the fill pads it to N.
  local desk_win=""
  if (( want_desk )); then
    local cur curinfo
    cur=$(_ail_tmux display-message -p -t "=$AIL_SESSION:" '#{pane_id}' 2>/dev/null)
    [[ -n "$cur" ]] && curinfo=$(_ail_tmux display-message -p -t "$cur" \
      '#{window_id}|#{window_panes}|#{pane_current_command}|#{@ai_agent}|#{@ai_placeholder}|#{@ai_manual}' 2>/dev/null)
    if [[ -n "$curinfo" ]]; then
      local -a cf
      cf=("${(@s:|:)curinfo}")
      if [[ "${cf[2]}" == 1 && "${cf[3]}" == "$shell_base" && -z "${cf[4]}" && -z "${cf[5]}" && -z "${cf[6]}" ]]; then
        _ail_tmux set-option -p -t "$cur" @ai_placeholder 1 2>/dev/null
        _ail_tmux select-pane -t "$cur" -T '·' 2>/dev/null
        desk_win="${cf[1]}"
      fi
    fi
    if [[ -z "$desk_win" ]]; then
      curinfo=$(_ail_tmux new-window -d -t "=$AIL_SESSION:" -c "$HOME" -PF '#{pane_id}|#{window_id}' 2>/dev/null)
      if [[ -n "$curinfo" ]]; then
        _ail_tmux set-option -p -t "${curinfo%%|*}" @ai_placeholder 1 2>/dev/null
        _ail_tmux select-pane -t "${curinfo%%|*}" -T '·' 2>/dev/null
        desk_win="${curinfo#*|}"
      fi
    fi
    # @ai_desk marks INTENT: a mode switch drains old tail decks into
    # pure-placeholder windows too, and those must stay strays (killed) —
    # only windows the user asked for survive as desks.
    [[ -n "$desk_win" ]] && _ail_tmux set-option -w -t "$desk_win" @ai_desk 1 2>/dev/null
  fi

  # ---- collect agent panes in spawn order ----
  local -a ids titles
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    ids+=("${line%%|*}")
    titles+=("${line#*|}")
  done < <(_ail_agent_panes)

  # Zero agents is no longer an early exit: decks=0 skips the packing loop and
  # the reconciliation below still builds (or clears) the placeholder desk.
  local -i total=${#ids}

  # Save focus: mode switches must not cost a manual navigation afterwards.
  # NB: display-message takes a target-PANE — exact-match needs "=name:"
  # (trailing colon); bare "=name" silently returns empty.
  local saved_pane
  saved_pane=$(_ail_tmux display-message -p -t "=$AIL_SESSION:" '#{pane_id}' 2>/dev/null)

  # Unzoom guard: resize-pane -Z is a TOGGLE — only touch windows that report
  # zoomed, or we would zoom the unzoomed ones. Scoped to windows holding agent
  # panes: a zoomed plain-shell window is not ours to unzoom (non-agent immunity).
  local agent_wins win flag
  agent_wins=$(_ail_tmux list-panes -s -t "=$AIL_SESSION" -f "$AIL_PACK_FILTER" -F '#{window_id}' 2>/dev/null | sort -u)
  while read -r win flag; do
    [[ "$flag" == 1 ]] || continue
    grep -qxF "$win" <<< "$agent_wins" || continue
    _ail_tmux resize-pane -Z -t "$win" 2>/dev/null
  done < <(_ail_tmux list-windows -t "=$AIL_SESSION" -F '#{window_id} #{window_zoomed_flag}' 2>/dev/null)

  # ---- re-pack, chunk by chunk ----
  local -i decks=$(( (total + n - 1) / n ))
  local -i di k start end formed
  local pid info anchor last uw wpanes
  local -a live live_wins chunk_titles

  for (( di = 1; di <= decks; di++ )); do
    start=$(( (di - 1) * n + 1 ))
    end=$(( di * n )); (( end > total )) && end=total

    # Re-verify liveness pane by pane: agents can exit mid-run — skip, never abort.
    live=(); live_wins=(); chunk_titles=()
    for (( k = start; k <= end; k++ )); do
      pid="${ids[$k]}"
      info=$(_ail_tmux display-message -p -t "$pid" '#{window_id}' 2>/dev/null) || continue
      [[ -z "$info" ]] && continue
      live+=("$pid")
      live_wins+=("$info")
      chunk_titles+=("${titles[$k]}")
    done
    (( ${#live} == 0 )) && continue

    # Mode 1: canonicalize with skip — panes already solo stay put (no flicker,
    # idempotent); tab name = pane title (manual rename disables auto-rename).
    if (( n == 1 )); then
      wpanes=$(_ail_tmux display-message -p -t "${live[1]}" '#{window_panes}' 2>/dev/null)
      if (( ${wpanes:-1} > 1 )); then
        _ail_tmux break-pane -d -s "${live[1]}" -t "=$AIL_SESSION:" 2>/dev/null || continue
      fi
      _ail_tmux rename-window -t "${live[1]}" "${chunk_titles[1]}" 2>/dev/null
      # Solo window: the tab carries the identity — border row off.
      _ail_tmux set-option -w -t "${live[1]}" pane-border-status off 2>/dev/null
      continue
    fi

    # Already-formed deck (one window, exactly these panes, spawn order):
    # rename + relayout only — zero break/join, so `ail N` twice is a no-op.
    # Placeholder panes are tolerated as extras — a padded tail deck must
    # read as formed, or every repack would churn it (and the pane-exited
    # hook relies on no-change repacks being no-ops). Any other extra pane
    # (a stray manual split) still breaks formedness.
    formed=1
    uw="${live_wins[1]}"
    for (( k = 2; k <= ${#live}; k++ )); do
      [[ "${live_wins[$k]}" == "$uw" ]] || { formed=0; break }
    done
    if (( formed )); then
      local wseq="" wline
      while IFS= read -r wline; do
        [[ "${wline#*|}" == 1 ]] && continue   # placeholder — tolerated
        wseq+="${wline%%|*} "
      done < <(_ail_tmux list-panes -t "$uw" -F '#{pane_id}|#{@ai_placeholder}' 2>/dev/null)
      [[ "$wseq" == "${(j: :)live} " ]] || formed=0
    fi
    if (( formed )); then
      _ail_tmux rename-window -t "$uw" "d$di" 2>/dev/null
      _ail_tmux select-layout -t "$uw" even-horizontal 2>/dev/null
      _ail_deck_borders "$uw"
      continue
    fi

    # Re-form. Fast path: when live[1]'s window already holds, in spawn
    # order, a strict PREFIX of this chunk and nothing else but placeholders
    # — the usual shapes: a new agent joining the padded tail deck, or a
    # repack after members left — that window stays THE deck: join only the
    # missing panes, right after the last member already in place. The
    # window id is stable (no tab-bar jump) and surplus placeholders are
    # consumed one by one by the reconciliation below instead of being
    # killed en masse and respawned. Fallback: canonicalize (break out panes
    # sharing a window; solo panes stay put — non-agent siblings are left
    # behind untouched), then join in spawn order after a fresh anchor.
    local -i join_from=0
    local -a in_win
    local wline ok
    uw=$(_ail_tmux display-message -p -t "${live[1]}" '#{window_id}' 2>/dev/null)
    if [[ -n "$uw" ]]; then
      in_win=(); ok=1
      while IFS= read -r wline; do
        [[ "${wline#*|}" == 1 ]] && continue   # placeholder — tolerated
        in_win+=("${wline%%|*}")
      done < <(_ail_tmux list-panes -t "$uw" -F '#{pane_id}|#{@ai_placeholder}' 2>/dev/null)
      # Strict prefix: in_win == live in full order is formed (handled above);
      # reaching here with equal size means the order differs — fall back.
      if (( ${#in_win} >= 1 && ${#in_win} < ${#live} )); then
        for (( k = 1; k <= ${#in_win}; k++ )); do
          [[ "${in_win[$k]}" == "${live[$k]}" ]] || { ok=0; break }
        done
      else
        ok=0
      fi
      if (( ok )); then
        anchor="$uw"
        last="${in_win[-1]}"
        join_from=$(( ${#in_win} + 1 ))
      fi
    fi
    if (( join_from == 0 )); then
      for (( k = 1; k <= ${#live}; k++ )); do
        pid="${live[$k]}"
        wpanes=$(_ail_tmux display-message -p -t "$pid" '#{window_panes}' 2>/dev/null) || continue
        (( ${wpanes:-1} > 1 )) && _ail_tmux break-pane -d -s "$pid" -t "=$AIL_SESSION:" 2>/dev/null
      done
      anchor="${live[1]}"
      last="$anchor"
      join_from=2
    fi
    _ail_tmux rename-window -t "$anchor" "d$di" 2>/dev/null
    # Joining after the PREVIOUS pane, not the anchor, preserves order:
    # join-pane inserts the src right after its target — so on the fast path
    # newcomers land between the last agent and the trailing placeholders.
    for (( k = join_from; k <= ${#live}; k++ )); do
      pid="${live[$k]}"
      _ail_tmux join-pane -d -h -s "$pid" -t "$last" 2>/dev/null || continue
      # Re-layout after every join: join-pane halves the TARGET pane, so
      # repeated joins starve width long before even-horizontal would.
      _ail_tmux select-layout -t "$anchor" even-horizontal 2>/dev/null
      last="$pid"
    done
    _ail_deck_borders "$anchor"
  done

  # ---- bookkeeping ----

  # Drained decks: a re-pack can leave a window that lost its agent panes (a
  # manual split inside a deck) still wearing its ail-given dN name — hand
  # naming back to tmux so window names stay unambiguous.
  local wname
  agent_wins=$(_ail_tmux list-panes -s -t "=$AIL_SESSION" -f "$AIL_PACK_FILTER" -F '#{window_id}' 2>/dev/null | sort -u)
  while read -r win wname; do
    [[ "$wname" == d<-> ]] || continue
    grep -qxF "$win" <<< "$agent_wins" && continue
    # An @ai_desk pure-placeholder window is a desk (ail --desk) — it keeps
    # its name; drained decks without the mark hand naming back as before.
    if [[ "$(_ail_tmux show-options -wv -t "$win" @ai_desk 2>/dev/null)" == 1 ]] && \
       ! _ail_tmux list-panes -t "$win" -F '#{@ai_placeholder}' 2>/dev/null | grep -qv '^1$'; then
      continue
    fi
    _ail_tmux set-option -w -t "$win" automatic-rename on 2>/dev/null
  done < <(_ail_tmux list-windows -t "=$AIL_SESSION" -F '#{window_id} #{window_name}' 2>/dev/null)

  # ---- placeholder reconciliation (fixed grid, multi-desk) ----
  # Desk windows: the tail deck (padded to N) plus every pure-placeholder
  # window — an "extra desk" (ail --desk), kept at exactly N panes.
  # Placeholders anywhere else are strays: killed when idle, promoted when
  # busy. All desk fills run BEFORE any stray kill (hook-safety: kills fire
  # pane-exited → concurrent repacks must observe already-padded desks).
  local tail_win=""
  local -i pad=0

  if (( n > 1 && total > 0 )); then
    local last_agent
    last_agent=$(_ail_agent_panes | tail -n1)
    last_agent="${last_agent%%|*}"
    [[ -n "$last_agent" ]] && tail_win=$(_ail_tmux display-message -p -t "$last_agent" '#{window_id}' 2>/dev/null)
    if [[ -n "$tail_win" ]]; then
      local -i in_tail
      in_tail=$(_ail_tmux list-panes -t "$tail_win" -f "$AIL_PACK_FILTER" -F x 2>/dev/null | wc -l | tr -d ' ')
      pad=$(( n - in_tail )); (( pad < 0 )) && pad=0
    fi
  elif (( n > 1 )); then
    # Zero agents: one desk of N placeholders — the "empty desk, ready to
    # work" feel. Reuse an existing pure-placeholder window; otherwise build
    # one (its first pane IS the first placeholder).
    pad=$n
    while IFS= read -r win; do
      if ! _ail_tmux list-panes -t "$win" -F '#{@ai_placeholder}' 2>/dev/null | grep -qv '^1$'; then
        tail_win="$win"
        break
      fi
    done < <(_ail_tmux list-panes -s -t "=$AIL_SESSION" -f '#{@ai_placeholder}' -F '#{window_id}' 2>/dev/null | sort -u)
    if [[ -z "$tail_win" ]]; then
      info=$(_ail_tmux new-window -d -t "=$AIL_SESSION:" -c "$HOME" -PF '#{pane_id}|#{window_id}' 2>/dev/null)
      if [[ -n "$info" ]]; then
        _ail_tmux set-option -p -t "${info%%|*}" @ai_placeholder 1 2>/dev/null
        _ail_tmux select-pane -t "${info%%|*}" -T '·' 2>/dev/null
        tail_win="${info#*|}"
      fi
    fi
    if [[ -n "$tail_win" ]]; then
      _ail_tmux rename-window -t "$tail_win" d1 2>/dev/null
      _ail_deck_borders "$tail_win"
    fi
  fi

  # Extra desks: pure-placeholder windows carrying @ai_desk (user intent —
  # `ail --desk`), other than the tail. Pure-placeholder windows WITHOUT the
  # mark are repack residue (a drained tail deck) and stay strays. Mode 1
  # keeps the list empty — there every placeholder is a stray ("ail 1 clears
  # the desk"). Idle = the pane's foreground command is still the shell.
  # Ceiling: a nested zsh or a zsh SCRIPT inside a placeholder also reports
  # the shell and reads as idle — killable. If that ever bites, weigh
  # window_activity recency alongside pane_current_command.
  local -a extra_desks
  extra_desks=()
  if (( n > 1 )); then
    while IFS= read -r win; do
      [[ "$win" == "$tail_win" ]] && continue
      [[ "$(_ail_tmux show-options -wv -t "$win" @ai_desk 2>/dev/null)" == 1 ]] || continue
      _ail_tmux list-panes -t "$win" -F '#{@ai_placeholder}' 2>/dev/null | grep -qv '^1$' && continue
      extra_desks+=("$win")
    done < <(_ail_tmux list-panes -s -t "=$AIL_SESSION" -f '#{@ai_placeholder}' -F '#{window_id}' 2>/dev/null | sort -u)
  fi

  # Fill every desk (spawns happen in here, before any stray kill below).
  [[ -n "$tail_win" ]] && _ail_fill_desk "$tail_win" "$pad" "$shell_base"
  for win in "${extra_desks[@]}"; do
    _ail_fill_desk "$win" "$n" "$shell_base"
  done

  # Name extra desks after the agent decks, in window order; desk borders on.
  if (( ${#extra_desks} )); then
    local -i dnum=$(( total > 0 ? decks : 1 ))
    while IFS= read -r win; do
      (( ${extra_desks[(Ie)$win]} )) || continue
      (( ++dnum ))
      _ail_tmux rename-window -t "$win" "d$dnum" 2>/dev/null
      _ail_deck_borders "$win"
    done < <(_ail_tmux list-windows -t "=$AIL_SESSION" -F '#{window_id}' 2>/dev/null)
  fi

  # Strays: placeholders living outside every desk window — read AFTER the
  # fills so freshly spawned desk panes are never misread as strays.
  local ph rest pcmd pwin
  local -a kills promotes
  while IFS= read -r ph; do
    [[ -z "$ph" ]] && continue
    pid="${ph%%|*}"; rest="${ph#*|}"
    pwin="${rest%%|*}"; pcmd="${rest#*|}"
    [[ -n "$tail_win" && "$pwin" == "$tail_win" ]] && continue
    (( ${extra_desks[(Ie)$pwin]} )) && continue
    if [[ "$pcmd" == "$shell_base" ]]; then kills+=("$pid"); else promotes+=("$pid"); fi
  done < <(_ail_tmux list-panes -s -t "=$AIL_SESSION" -f '#{@ai_placeholder}' -F '#{pane_id}|#{window_id}|#{pane_current_command}' 2>/dev/null)

  # Promote busy strays: a shell the user started something in becomes a
  # plain window — untouchable, like any manual window. Kill idle ones.
  for pid in "${promotes[@]}"; do
    _ail_tmux set-option -p -u -t "$pid" @ai_placeholder 2>/dev/null
    wpanes=$(_ail_tmux display-message -p -t "$pid" '#{window_panes}' 2>/dev/null)
    (( ${wpanes:-1} > 1 )) && _ail_tmux break-pane -d -s "$pid" -t "=$AIL_SESSION:" 2>/dev/null
    win=$(_ail_tmux display-message -p -t "$pid" '#{window_id}' 2>/dev/null)
    [[ -n "$win" ]] && _ail_tmux set-option -w -t "$win" automatic-rename on 2>/dev/null
  done
  for pid in "${kills[@]}"; do
    _ail_tmux kill-pane -t "$pid" 2>/dev/null
  done

  # Restore focus, skipping if the saved pane died mid-run. Explicit `ail N`
  # called from a window holding no deck member (a fresh plain tab, a manual
  # layout): jump to the desk instead — the user asked to SEE mode N, and
  # restoring focus to a window the pack never touches reads as a no-op.
  # --repack (quiet) never steals focus.
  if [[ -n "$saved_pane" ]] && \
     _ail_tmux list-panes -s -t "=$AIL_SESSION" -F '#{pane_id}' 2>/dev/null | grep -qxF "$saved_pane"; then
    local jump=""
    if (( ! quiet )) && \
       [[ -z "$(_ail_tmux list-panes -t "$saved_pane" -f "#{||:${AIL_PACK_FILTER},#{@ai_placeholder}}" -F x 2>/dev/null | head -n1)" ]]; then
      jump=$(_ail_agent_panes | head -n1); jump="${jump%%|*}"
      [[ -z "$jump" ]] && jump="$tail_win"
    fi
    if [[ -n "$jump" ]]; then
      _ail_tmux select-window -t "$jump" 2>/dev/null
    else
      _ail_tmux select-window -t "$saved_pane" 2>/dev/null
      _ail_tmux select-pane -t "$saved_pane" 2>/dev/null
    fi
  fi

  # --desk: land on the new desk — the gesture IS "give me a desk here".
  [[ -n "$desk_win" ]] && _ail_tmux select-window -t "$desk_win" 2>/dev/null

  # ---- feedback: in-tmux flash when a client is attached; always stdout ----
  # --repack is quiet by contract: it runs on EVERY pane death — a flash (or
  # any stdout under run-shell) on each one would be pure noise.
  (( quiet )) && return 0
  local agents attached msg
  agents=$(_ail_agent_panes | wc -l | tr -d ' ')
  msg="ail: mode $n · $agents agents · $(_ail_deck_count) decks"
  attached=$(_ail_tmux display-message -p -t "=$AIL_SESSION:" '#{session_attached}' 2>/dev/null)
  (( ${attached:-0} > 0 )) && _ail_tmux display-message "$msg" 2>/dev/null
  print -r -- "$msg"
}

_ail_main "$@"
