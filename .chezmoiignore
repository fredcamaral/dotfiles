# chezmoi ignore file
# Entries are TARGET paths (what lands in $HOME), not source paths.
# Anything here is NOT managed by chezmoi.

# ─── Repo-only files (live in the repo, never applied to $HOME) ───
README.md
scripts

# ─── Git internals ───
**/.git
**/.git/**

# ─── OS cruft ───
.DS_Store
Thumbs.db

# ─── Editor backups / swap ───
*~
*.swp
*.swo
*.bak

# ─── Compiled / cache ───
*.pyc
__pycache__
.cache/
.zcompdump*

# ─── Temp ───
*.tmp
*.temp
.claude.json.tmp.*

# ─── Shell sessions / history ───
.zsh_sessions/
.zsh_history
.bash_history
.viminfo
.lesshst

# ─── Tool plugin/lock dirs (auto-regenerated) ───
.config/nvim/lazy-lock.json
.tmux/plugins/
.config/karabiner/automatic_backups/
.config/goose/mcp-hermit/
.config/goose/history.txt
.claude/debug/
.gitkraken/

# ══════════════════════════════════════════════════════════
# SECRETS — MUST NEVER be committed (this repo is PUBLIC)
# ══════════════════════════════════════════════════════════
# Shell modules holding infra / Lerian tokens (ARGOCD, VAULT, Matcher)
.config/zsh/secrets.zsh
.config/zsh/paperclip.zsh
# Credentials written in-place by tools (oauth tokens, API keys)
.npmrc
.config/op
.config/github-copilot
.config/opencode/opencode.jsonc
.config/openkb/.env
.config/infracost
.config/amp
.config/devin
.config/sanity
.config/toad
.config/peakypanes

# ══════════════════════════════════════════════════════════
# STATE / CACHE / DISPOSABLE — tool-owned, not config
# ══════════════════════════════════════════════════════════
# opencode: keep only declarative config (config.json, tui.json, AGENTS.md),
# drop 173MB of state — blacklist the state explicitly (gitignore-style `!`
# cannot re-include a file once its parent is excluded by `**`).
.config/opencode/node_modules
.config/opencode/plugins
.config/opencode/docs
.config/opencode/agent
.config/opencode/command
.config/opencode/skill
.config/opencode/bun.lock
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/.gitignore
# micro: keep settings+bindings, drop downloaded plugins/buffers/backups
.config/micro/backups
.config/micro/buffers
.config/micro/plug
# herdr / mole: keep config, drop logs/sockets/sessions
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session*.json
.config/herdr/release-notes.json
.config/mole/*.log
# ai-sessions: keep the sourced script, drop backups
.config/ai-sessions/*.bak
# .factory (Factory/droid): keep ONLY authored hooks/. Everything else is auth
# secrets (auth.*, mcp.json), session transcripts (contain repo code + leaked
# tokens!), plugin-provided droids/commands/skills, or pure state.
.factory/auth.encrypted
.factory/auth.v2.key
.factory/auth.v2.file
.factory/host.json
.factory/mcp.json
.factory/settings.json
.factory/history.json
.factory/background-tasks.json
.factory/background-processes.json
.factory/cli-hints.json
.factory/telemetry
.factory/sessions
.factory/logs
.factory/artifacts
.factory/cache
.factory/certs
.factory/bin
.factory/droids
.factory/commands
.factory/skills
.factory/specs
.factory/plugins
.factory/sounds
# Pure state / cache / disposable dirs
.config/superpowers
.config/configstore
.config/uv
.config/ubs
.config/yarn
.config/cagent
# Unused / residual tool dirs (apps not installed or migrated away)
.config/fish
.config/waveterm
.config/iterm2
.config/crush
.config/fabric
.config/ring

# ─── Misc disposable dotfiles ───
.lmstudio-home-pointer
.cleanmymac-agent.plist.disabled
